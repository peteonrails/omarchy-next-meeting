{
  "schemaVersion": 1,
  "id": "peteonrails.next-meeting",
  "name": "Next Meeting",
  "version": "1.3.4",
  "author": "Pete Jackson",
  "license": "MIT",
  "description": "Always-visible \"Next: in 12m · Standup\" bar label fed by any command that prints the documented JSON. Speaks a warning before a meeting starts (and notifies instead when you're already in a call); pulses when a meeting is imminent, turns green once you've joined.",
  "homepage": "https://github.com/peteonrails/omarchy-next-meeting",
  "repository": "https://github.com/peteonrails/omarchy-next-meeting",
  "keywords": [
    "calendar",
    "meeting",
    "agenda",
    "gcalcli",
    "bar-widget",
    "zoom",
    "notifications",
    "text-to-speech"
  ],
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Next Meeting",
    "description": "Upcoming meeting label with spoken warnings and an urgent pulse",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "agendaCommand": "agenda --next-json",
      "openCommand": "xdg-open {{url}}",
      "joinCommand": "",
      "agendaViewCommand": "omarchy-launch-floating-terminal-with-presentation agenda",
      "maxTitleLength": 32,
      "announceMinutes": "5,1",
      "announceCommand": "say {{text}}",
      "notifyCommand": "notify-send -u critical -a 'Next Meeting' {{title}} {{text}}",
      "inMeetingCheckCommand": "pgrep -x zoom >/dev/null 2>&1 || hyprctl clients -j 2>/dev/null | grep -qi '\"class\": *\"[^\"]*zoom'",
      "handoverMinutes": 10
    },
    "schema": [
      {
        "key": "agendaCommand",
        "type": "string",
        "label": "Command printing the next-meeting JSON on stdout",
        "defaultValue": "agenda --next-json"
      },
      {
        "key": "openCommand",
        "type": "string",
        "label": "Open an event — {{url}} and {{title}} are substituted",
        "defaultValue": "xdg-open {{url}}"
      },
      {
        "key": "joinCommand",
        "type": "string",
        "label": "Join a video conference (blank = use the open command)",
        "defaultValue": ""
      },
      {
        "key": "agendaViewCommand",
        "type": "string",
        "label": "Right-click command — show the full agenda",
        "defaultValue": "omarchy-launch-floating-terminal-with-presentation agenda"
      },
      {
        "key": "announceMinutes",
        "type": "string",
        "label": "Warn this many minutes before the start (comma separated, blank = never)",
        "defaultValue": "5,1"
      },
      {
        "key": "announceCommand",
        "type": "string",
        "label": "Speak a warning — {{text}}, {{title}}, {{start}} and {{minutes}} are substituted",
        "defaultValue": "say {{text}}"
      },
      {
        "key": "notifyCommand",
        "type": "string",
        "label": "Warn silently instead when the in-meeting check succeeds",
        "defaultValue": "notify-send -u critical -a 'Next Meeting' {{title}} {{text}}"
      },
      {
        "key": "inMeetingCheckCommand",
        "type": "string",
        "label": "Exit 0 means a call is already running — silences speech, turns the widget green",
        "defaultValue": "pgrep -x zoom >/dev/null 2>&1 || hyprctl clients -j 2>/dev/null | grep -qi '\"class\": *\"[^\"]*zoom'"
      },
      {
        "key": "handoverMinutes",
        "type": "integer",
        "label": "While in a meeting, hand the label to the next one this many minutes before it starts (0 = never)",
        "min": 0,
        "max": 240,
        "defaultValue": 10
      },
      {
        "key": "maxTitleLength",
        "type": "integer",
        "label": "Truncate meeting titles beyond this many characters",
        "min": 8,
        "max": 120,
        "defaultValue": 32
      }
    ]
  }
}
